backend/validation-results.json
backend/validation-report.txt
backend/validation-metrics.json
backend/validation-ablations.json
backend/test-results/

# Private local agent evaluation and replay tooling.
backend/evaluation/agent/
backend/tests/replays/
backend/scripts/run_agent_replay_validation.py
backend/tests/test_agent_evals.py

# Track current documentation. Other generated material under docs stays local
