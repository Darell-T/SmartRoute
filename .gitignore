# Python
__pycache__/
*.pyc
*.pyo
*.pyd
backend/.venv/

# Large GTFS static data files (downloaded at runtime)
backend/data/gtfs_static/stop_times.txt
backend/data/gtfs_static/shapes.txt
backend/data/gtfs_static/trips.txt
backend/data/gtfs_supplemented/stop_times.txt
data/
backend/data/
# Fix B: the precomputed stop-pattern artifact is small and MUST ship to the
# server (loaded into memory at startup), so re-include it past the data/ rule.
!backend/app/data/
!backend/app/data/stop_patterns.json
# Fix C: the agent's curated static facts file is source, not runtime data --
# re-include it past the data/ rule the same way as stop_patterns.json above.
!backend/app/services/agent/data/
!backend/app/services/agent/data/transit_facts.md
.gtfs-cache/
.worktrees/

# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/
next.user-config.*

# Environment variables
.env*
!.env.example

# Local ATLAS prompt override
backend/app/services/ai_advisor_system_prompt.txt
# Common ignores
node_modules/
.next/
.DS_Store
# TypeScript build info
*.tsbuildinfo

# Local Cursor / agent skills lock (not for repo)
skills-lock.json

.agents/

# Local design reference assets (not for remote)
reference_images/

# Generated subway debug diagnostics (regenerated by the subway build; dev-only).
# Build scripts now write these under frontend/artifacts/debug (never served);
# the public/ globs remain to catch any older outputs.
frontend/artifacts/
frontend/public/*-debug-*.geojson
frontend/public/*-debug-*.json
frontend/public/debug/

# Generated QA screenshot runs (hundreds of MB; not for the repo)
docs/assets/subway-real-app-route-qa/

# Dev-server / build logs (scratch)
frontend/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend build / test / QA scratch outputs
coverage/
dist/
out/
storybook-static/
frontend/coverage/
frontend/dist/
frontend/out/
frontend/test-results/
frontend/playwright-report/
frontend/scripts/.tmp/
frontend/scripts/tmp/
frontend/scripts/qa/.tmp/
frontend/scripts/qa/tmp/
frontend/scripts/qa/output/
frontend/scripts/qa/screenshots/

# Local browser profiles + python cache (QA/screenshot scratch)
.tmp-chrome-*/
.pytest_cache/

# Deterministic route-intelligence reports are generated per run and uploaded
# by CI; keep local timing-bearing copies out of commits.
backend/validation-results.json
backend/validation-report.txt
backend/validation-metrics.json
backend/validation-ablations.json

# Only README screenshot PNGs may be tracked under docs/
docs/*
!docs/assets/
docs/assets/*
!docs/assets/*.png

# Internal agent/session material (not for the deployed repo)
.superpowers/
.claude/

# Generated per-run by the eval harness fixture router (debug manifest)
backend/evals/fixtures/*/index.json
