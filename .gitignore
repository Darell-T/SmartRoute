docs/*
!docs/*.md
docs/SMARTROUTE_INTERVIEW_HANDBOOK.md
!docs/assets/
docs/assets/*
!docs/assets/*.png

# Platform-local Playwright visual snapshots are not CI evidence.
frontend/tests/release/*.spec.ts-snapshots/

# Internal agent/session material (not for the deployed repo)
.superpowers/
.claude/

# Generated per-run by the eval harness fixture router (debug manifest)
backend/evaluation/agent/fixtures/*/index.json
