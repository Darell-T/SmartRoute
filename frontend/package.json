{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build:network": "tsx scripts/regenerate-canonical-from-gtfs.ts",
    "build:visual-network": "tsx scripts/build-subway-visual-network.mjs",
    "build:station-anchors": "tsx scripts/build-subway-station-anchors.ts",
    "build:artifact-manifest": "tsx scripts/build-artifact-manifest.ts",
    "build:transit-artifacts": "npm run build:network && npm run build:visual-network && npm run build:station-anchors && npm run build:artifact-manifest",
    "test:station-anchors": "tsx --test scripts/build/station-anchors/index.test.ts",
    "test:unit": "tsx --test lib/backend-proxy.test.mjs lib/ws-ticket.test.mjs lib/use-service-alerts.test.mjs components/smart-route/left-rail/live-data.test.mjs components/smart-route/left-rail/hydration.test.mjs scripts/build/station-anchors/index.test.ts",
    "check:station-overlay": "node components/map/subway-station-overlay.check.mjs",
    "check:subway-palette": "node components/map/subway-palette.check.mjs",
    "check:subway-renderer": "node components/map/subway-renderer.check.mjs",
    "verify:transit-artifacts": "npm run test:station-anchors && npm run check:station-overlay && npm run check:subway-palette && npm run check:subway-renderer",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run typecheck && npm run test:unit && npm run verify:transit-artifacts",
    "prebuild": "npm run build:transit-artifacts && npm run verify:transit-artifacts",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.0",
    "@deck.gl/layers": "^9.3.0",
    "@deck.gl/mapbox": "^9.3.0",
    "@mapbox/polyline": "^1.2.1",
    "@types/three": "^0.183.1",
    "@vercel/analytics": "1.6.1",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "lucide-react": "^0.564.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.38.0",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.3.1",
    "three": "^0.183.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3"
  }
}
