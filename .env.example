# SmartRoute server configuration example.
# Copy the values you need into a local .env or provider-managed secret store.
# Keep this file to placeholders only; do not commit a real key.

# Required to start the FastAPI app. Also shared with the server-side Next.js
# proxy and WebSocket ticket minting route; never expose it as NEXT_PUBLIC_*.
APP_KEY=replace-with-a-long-random-server-secret

# Explicit local/test profile required for in-memory admission fallback. Use
# SMARTROUTE_ENV=production in deployed environments; never rely on omission.
SMARTROUTE_ENV=development

# Required for shared production chat sessions and admission leases. It is
# optional only for local/test or non-chat work; leave memory sessions disabled
# outside an explicit local/test profile.
REDIS_URL=
# AGENT_ALLOW_MEMORY_SESSIONS=1

# Required for live transit route candidates.
GOOGLE_ROUTES_API_KEY=replace-with-google-routes-server-key

# Required when AGENT_ENABLED is not 0. Keep this server-side.
ANTHROPIC_API_KEY=replace-with-anthropic-server-key
# Conversational agent model routing. AGENT_MODEL remains a backwards-
# compatible Auto alias; set these explicit IDs to models supported by the
# installed Anthropic SDK and your account.
AGENT_AUTO_MODEL=claude-sonnet-5
AGENT_QUICK_MODEL=claude-haiku-4-5-20251001
AGENT_AUTO_MAX_ROUTE_CANDIDATES=5
AGENT_QUICK_MAX_ROUTE_CANDIDATES=2
AGENT_AUTO_RETRY_COUNT=2
AGENT_QUICK_RETRY_COUNT=1
AGENT_AUTO_MAX_OUTPUT_TOKENS=900
AGENT_QUICK_MAX_OUTPUT_TOKENS=360

# Optional: enables the bounded Grok incident investigation. It retains X and
# web search as xAI server-side tools and can call only the local cached 511NY
# candidate-stop search tool.
XAI_API_KEY=replace-with-xai-server-key
XAI_INCIDENT_TIMEOUT_S=12
TRIP_INCIDENT_SCAN_TIMEOUT_S=25
# Used only by the agent plan_trip tool; it has a separately bounded budget.
AGENT_GROK_BUDGET_S=6
# Bounded route-crowd research. Auto mode can use Grok web and X search;
# Quick mode uses only cached/structured evidence unless explicitly escalated.
GROK_CROWD_SEARCH_ENABLED=true
XAI_CROWD_MODEL=grok-4-1-fast-reasoning
CROWD_SEARCH_TIMEOUT_S=6

# Optional official 511NY event snapshots. Leaving NY511_API_KEY blank, or
# setting NY511_ENABLED=false, disables only this source; route planning and
# other incident inputs continue. This key is sent only by the backend.
NY511_API_KEY=
NY511_ENABLED=true
NY511_API_BASE_URL=https://511ny.org/api/v2/get/event
NY511_POLL_INTERVAL_SECONDS=300
NY511_REQUEST_TIMEOUT_SECONDS=10
NY511_STALE_AFTER_SECONDS=900
NY511_MAX_STALE_SECONDS=3600
NY511_NYC_BUFFER_DEGREES=0.05

# Optional Ticketmaster Discovery v2 event lookup. With no key, only the
# event_lookup tool is unavailable; no code change is needed after adding it.
TICKETMASTER_API_KEY=
TICKETMASTER_ENABLED=true
TICKETMASTER_SEARCH_RADIUS_MILES=25
EVENT_LOOKUP_TIMEOUT_S=6

# Manual-only, one-request Ticketmaster integration smoke test. Do not set in
# normal local development or production.
# TICKETMASTER_LIVE_SMOKE_TEST=1

# Optional preprocessed full-GTFS schedule used only when realtime arrivals
# are unavailable or stale. Regenerate it with the documented build script.
GTFS_SCHEDULE_ARTIFACT=

# Privacy-minimized counterfactual route shadowing. It remains disabled unless
# both the feature flag and a local .jsonl sink are configured.
ROUTE_SHADOW_VALIDATION_ENABLED=false
ROUTE_SHADOW_LOG_PATH=
ROUTE_SHADOW_SAMPLE_RATE=0.05
ROUTE_SHADOW_TIMEOUT_SECONDS=2.0
