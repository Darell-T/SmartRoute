# SmartRoute server configuration example.
# Copy the values you need into a local .env or provider-managed secret store.
# Keep this file to placeholders only; do not commit a real key.

# Required to start the FastAPI app. Also shared with the server-side Next.js
# proxy and WebSocket ticket minting route; never expose it as NEXT_PUBLIC_*.
APP_KEY=replace-with-a-long-random-server-secret

# Explicit local/test profile required for in-memory admission fallback. Use
# SMARTROUTE_ENV=production in deployed environments; never rely on omission.
SMARTROUTE_ENV=development

# Required for shared production chat sessions and admission leases, and for
# the incident-refresh cron service: the cron process writes the shared
# incident index through this same Redis, and the web service reads it. It is
# optional only for local/test or non-chat work; leave memory sessions disabled
# outside an explicit local/test profile.
REDIS_URL=
# Bound request-path Redis work. These apply to the shared cache/index client
# and admission client; blocking operations run off the async event loop.
REDIS_CONNECT_TIMEOUT_S=0.5
REDIS_READ_TIMEOUT_S=1.0
# AGENT_ALLOW_MEMORY_SESSIONS=1

# Required for live transit route candidates.
GOOGLE_ROUTES_API_KEY=replace-with-google-routes-server-key
# Hard ceiling for the model-free POST /api/trip path. Keep this below the
# rider-visible 30-second failure mode the migration was designed to remove.
DIRECT_TRIP_DEADLINE_S=15

# Required when AGENT_ENABLED is not 0. Keep this server-side.
ANTHROPIC_API_KEY=replace-with-anthropic-server-key
# Conversational agent model routing. AGENT_MODEL remains a backwards-
# compatible Auto alias; set these explicit IDs to models supported by the
# installed Anthropic SDK and your account.
AGENT_AUTO_MODEL=claude-sonnet-4-6
AGENT_QUICK_MODEL=claude-haiku-4-5-20251001
AGENT_AUTO_MAX_ROUTE_CANDIDATES=5
AGENT_QUICK_MAX_ROUTE_CANDIDATES=2
AGENT_AUTO_RETRY_COUNT=2
AGENT_QUICK_RETRY_COUNT=1
AGENT_AUTO_MAX_OUTPUT_TOKENS=900
AGENT_QUICK_MAX_OUTPUT_TOKENS=360

# Local/test-only deterministic replay/record controls for agent tool calls
# (eval harness). Startup rejects a non-empty AGENT_TOOL_FIXTURES or a truthy
# AGENT_TOOL_FIXTURES_RECORD outside an explicit local/test runtime profile,
# including Render. Keep both commented and unset; never set them in
# production or normal development.
# AGENT_TOOL_FIXTURES=
# AGENT_TOOL_FIXTURES_RECORD=

# Shared xAI key for the two server-only xAI boundaries below. Never expose
# it as NEXT_PUBLIC_*.
XAI_API_KEY=replace-with-xai-server-key

# Boundary 1 - background-only broad incident scouting: used only by the
# incident-refresh cron service (render.yaml), never by rider requests. The
# web service reads the shared incident index this job writes; request-time
# incident lookup reads only that index and never calls xAI.
XAI_INCIDENT_MODEL=grok-4-1-fast-reasoning
# Defaults to 12 seconds and is clamped from 1 to 30.
XAI_INCIDENT_TIMEOUT_S=12
# Hard ceiling for the request-time shared-index lookup (no provider calls).
INCIDENT_LOOKUP_TIMEOUT_S=1.5
# Optional secret for the manual/internal HTTP trigger of the incident-refresh
# job (POST /api/internal/incident-refresh with header X-Cron-Secret). Omit it
# to keep that route a 404; the Render cron service runs the CLI directly and
# does not need it.
# INCIDENT_JOB_CRON_SECRET=

# Boundary 2 - optional bounded route-crowd X/Web research: may run on an
# eligible rider request only when crowd collection is required (an explicit
# crowd-avoidance request or route hotspot hits) and live search is allowed
# (Auto mode; Quick mode uses only cached/structured evidence unless
# explicitly escalated). Results are cached for five minutes with a hard
# deadline; this is not broad incident research.
GROK_CROWD_SEARCH_ENABLED=true
XAI_CROWD_MODEL=grok-4-1-fast-reasoning
# Defaults to 6 seconds and is clamped from 1 to 6.
CROWD_SEARCH_TIMEOUT_S=6

# DORMANT legacy 511NY module: not part of routing or the background
# incident-index target architecture, and not deleted. The module is not wired
# into the application lifecycle or the incident refresh job; the migration
# keeps 511NY rollback-only with no active imports. Fail closed: the dormant
# module's own default for NY511_ENABLED is true, so this example sets false.
# These settings remain only for rollback provenance; NY511_API_KEY would be
# sent only by the backend if the module were re-enabled.
NY511_API_KEY=
NY511_ENABLED=false
NY511_API_BASE_URL=https://511ny.org/api/v2/get/event
NY511_POLL_INTERVAL_SECONDS=300
NY511_REQUEST_TIMEOUT_SECONDS=10
NY511_STALE_AFTER_SECONDS=900
NY511_MAX_STALE_SECONDS=3600
NY511_NYC_BUFFER_DEGREES=0.05

# Optional Ticketmaster Discovery v2 event lookup. With no key, only the
# event_lookup tool is unavailable; no code change is needed after adding it.
TICKETMASTER_API_KEY=
TICKETMASTER_ENABLED=true
TICKETMASTER_SEARCH_RADIUS_MILES=25
EVENT_LOOKUP_TIMEOUT_S=6

# Manual-only, one-request Ticketmaster integration smoke test. Do not set in
# normal local development or production.
# TICKETMASTER_LIVE_SMOKE_TEST=1

# Optional preprocessed full-GTFS schedule used only when realtime arrivals
# are unavailable or stale. Regenerate it with the documented build script.
GTFS_SCHEDULE_ARTIFACT=

# Privacy-minimized counterfactual route shadowing. It remains disabled unless
# both the feature flag and a local .jsonl sink are configured.
ROUTE_SHADOW_VALIDATION_ENABLED=false
ROUTE_SHADOW_LOG_PATH=
ROUTE_SHADOW_SAMPLE_RATE=0.05
ROUTE_SHADOW_TIMEOUT_SECONDS=2.0
